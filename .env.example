# Copy this file to .env and override only the values you want to customize.
# Every variable below matches the defaults in compose.yml when unset.

# --- Host Ports ---
VITE_PORT=5173
SERVER_PORT=3000
POSTGRES_PORT=5432

# --- PostgreSQL Database ---
POSTGRES_USER=eliopeli
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=eliopeli

# Full connection string override (optional; if unset, compose.yml builds it
# from POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB against host "db").
# DATABASE_URL=postgresql://eliopeli:devpassword@db:5432/eliopeli

# --- Server & Auth (Dev) ---
NODE_ENV=development
DEV_ADMIN_PASSWORD=admin

# Optional overrides in compose.yml; if left unset, the server startup script
# generates a random 32-byte hex SESSION_SECRET and hashes DEV_ADMIN_PASSWORD.
# SESSION_SECRET=
# ADMIN_PASSWORD_HASH=

# --- Frontend (Vite) ---
CHOKIDAR_USEPOLLING=true
VITE_API_TARGET=http://server:3000